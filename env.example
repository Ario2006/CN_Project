#make an env file in the project root name env.sh and copy this to there 


export TEAM="[Team Name]"                     # team domain: teamX.test
export DOMAIN="team${TEAM}.test"
export IFACE="en0"
export WIFI_SERVICE="Wi-Fi"         # check: networksetup -listallnetworkservices

# ---- Network & Subnet Mask ----
export SUBNET=""
export NETMASK=""
export NETMASK_HEX=""
export GATEWAY=""
export BROADCAST=""

# ---- Real IP Addresses ----
export MAC1_IP=""         # Aryan     - DNS (dnsmasq) + test client
export MAC2_IP=""         # Ranajeet  - nginx edge / LB / TLS
export MAC3_IP=""          # Abhijeet  - Backend A :3001
export MAC4_IP=""          # Ankita    - Backend B :3002 + capture client

# ---- Real On-The-Air MACs (Wireshark / 802.11 frames) ----
export MAC1_AIR_MAC=""
export MAC2_AIR_MAC=""
export MAC3_AIR_MAC=""
export MAC4_AIR_MAC=""

# ---- Real Hardware MACs (networksetup permanent MACs) ----
export MAC1_HW_MAC=""
export MAC2_HW_MAC=""
export MAC3_HW_MAC=""
export MAC4_HW_MAC=""

# ---- Ports ----
export BACKEND_A_PORT="3001"
export BACKEND_B_PORT="3002"
export HTTPS_PORT="443"             # use 8443 only if 443 fails

# ---- Upstream Resolvers ----
export UPSTREAM_DNS_1="[IP_ADDRESS]"    # campus resolver (so Mac1 can forward normal names)
export UPSTREAM_DNS_2="[IP_ADDRESS]"